[
  {
    "doctype": "Notification",
    "name": "Loan Schedule Payment Due Alert",
    "enabled": 0,
    "subject": "Loan Payment Due: {{ doc.parent }} – {{ doc.due_date }}",
    "document_type": "Bank Loan Schedule Line",
    "event": "Days After",
    "days_in_advance": 0,
    "date_changed": "due_date",
    "condition": "doc.status == \"Pending\"",
    "channel": "Email",
    "recipients": [
      {
        "doctype": "Notification Recipient",
        "receiver_by_role": "Accounts Manager"
      },
      {
        "doctype": "Notification Recipient",
        "receiver_by_role": "Accounts User"
      }
    ],
    "message": "<p>A loan repayment is due but no Journal Entry has been posted.</p>\n<table style=\"border-collapse:collapse;width:100%;font-size:13px;\">\n  <tr style=\"background:#f3f4f6;\">\n    <th style=\"padding:8px 10px;text-align:left;\">Field</th>\n    <th style=\"padding:8px 10px;text-align:left;\">Value</th>\n  </tr>\n  <tr><td style=\"padding:6px 10px;\">Schedule</td><td style=\"padding:6px 10px;\">{{ doc.parent }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Due Date</td><td style=\"padding:6px 10px;\">{{ doc.due_date }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Total Payment</td><td style=\"padding:6px 10px;\">{{ doc.total_payment }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Principal</td><td style=\"padding:6px 10px;\">{{ doc.principal_amount }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Interest</td><td style=\"padding:6px 10px;\">{{ doc.interest_amount }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Outstanding After</td><td style=\"padding:6px 10px;\">{{ doc.outstanding_amount }}</td></tr>\n</table>"
  },
  {
    "doctype": "Notification",
    "name": "Loan Repayment Posting Reminder",
    "enabled": 1,
    "subject": "Action Required: Post Loan Repayment JE – {{ doc.parent }} ({{ doc.due_date }})",
    "document_type": "Bank Loan Schedule Line",
    "event": "Days After",
    "days_in_advance": 0,
    "date_changed": "due_date",
    "condition": "doc.status == \"Pending\"",
    "channel": "Email",
    "recipients": [
      {
        "doctype": "Notification Recipient",
        "receiver_by_role": "Accounts Manager"
      }
    ],
    "message": "<p>This is a reminder that a loan repayment is due today and the Journal Entry has <strong>not yet been posted</strong>.</p>\n<p>Please open the loan schedule and post the repayment Journal Entry at your earliest convenience.</p>\n<table style=\"border-collapse:collapse;width:100%;font-size:13px;margin-top:12px;\">\n  <tr style=\"background:#f3f4f6;\">\n    <th style=\"padding:8px 10px;text-align:left;\">Field</th>\n    <th style=\"padding:8px 10px;text-align:left;\">Value</th>\n  </tr>\n  <tr><td style=\"padding:6px 10px;\">Schedule</td><td style=\"padding:6px 10px;\">{{ doc.parent }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Due Date</td><td style=\"padding:6px 10px;\">{{ doc.due_date }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Total Payment</td><td style=\"padding:6px 10px;\">{{ doc.total_payment }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Principal</td><td style=\"padding:6px 10px;\">{{ doc.principal_amount }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Interest</td><td style=\"padding:6px 10px;\">{{ doc.interest_amount }}</td></tr>\n  <tr><td style=\"padding:6px 10px;\">Outstanding After</td><td style=\"padding:6px 10px;\">{{ doc.outstanding_amount }}</td></tr>\n</table>\n<p style=\"margin-top:16px;\"><a href=\"/app/bank-loan-schedule/{{ doc.parent }}\">Open Loan Schedule →</a></p>"
  }
]
